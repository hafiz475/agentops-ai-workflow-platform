{
  "name": "@agentops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "worker": "node dist/src/worker.js"
  },
  "dependencies": {
    "@agentops/contracts": "*",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.1.8",
    "bullmq": "^5.81.5",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.11.10",
    "jszip": "^3.10.2",
    "pdfkit": "^0.20.2",
    "tsx": "^4.19.2"
  }
}
